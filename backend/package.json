{
  "name": "biomedical-research-studio",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test tests/browser",
    "test:e2e": "playwright test",
    "check": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.3.0",
    "@sinclair/typebox": "^0.34.41",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "pizzip": "^3.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.19.0"
}
